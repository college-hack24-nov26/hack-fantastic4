{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vision:contracts:detection:0.1.0",
  "title": "Vision detection result (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "timestampMs", "detections"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "timestampMs": { "type": "integer", "minimum": 0 },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "boundingBox"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "boundingBox": {
            "type": "object",
            "additionalProperties": false,
            "required": ["left", "top", "right", "bottom"],
            "properties": {
              "left": { "type": "number", "minimum": 0, "maximum": 1 },
              "top": { "type": "number", "minimum": 0, "maximum": 1 },
              "right": { "type": "number", "minimum": 0, "maximum": 1 },
              "bottom": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    }
  }
}
